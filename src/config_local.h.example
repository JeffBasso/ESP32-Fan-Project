/**
 * @file config_local.h.example
 * @brief Template for local provisioning secrets — copy to config_local.h and fill in your values.
 *
 * config_local.h is gitignored and never committed.
 * This example file is committed so cloners know what to create.
 */
#pragma once

#define PROV_SERVICE_NAME  "PROV_YourDeviceName" ///< BLE advertised service name shown in the provisioning app
#define PROV_POP           "00000000"             ///< Proof-of-possession PIN entered in the provisioning app
